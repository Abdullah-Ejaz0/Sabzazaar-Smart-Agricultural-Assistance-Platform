<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.sabzazaar"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <permission
        android:name="com.example.sabzazaar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.sabzazaar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.Sabzazaar"
        android:usesCleartextTraffic="true" >

        <!-- Auth Activities -->
        <activity
            android:name="com.example.sabzazaar.activities.auth.SplashActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.sabzazaar.activities.auth.OtpPageActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.auth.OnBoardingStartActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.auth.MobileNumberGetActivity"
            android:exported="false" />

        <!-- Main/Feature Activities -->
        <activity
            android:name="com.example.sabzazaar.activities.main.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.main.ChatbotActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.main.SoilHealthActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.main.WeatherDetailsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.main.AskQuestionActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.main.QuestionDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.main.HelpActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.main.AboutActivity"
            android:exported="false" />

        <!-- Profile Activities -->
        <activity
            android:name="com.example.sabzazaar.activities.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.profile.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.profile.SettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.profile.MoreLanguageActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.profile.MyQuestionsActivity"
            android:exported="false" />

        <!-- Scan Activities -->
        <activity
            android:name="com.example.sabzazaar.activities.scan.ScanCameraActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.scan.ScanPreviewActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.scan.ScanAnalysisActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.scan.ScanTreatmentActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.scan.ScanDetailsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.scan.ScanResultsActivity"
            android:exported="false" />

        <!-- Expert Activities -->
        <activity
            android:name="com.example.sabzazaar.activities.expert.ExpertLoginActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.expert.ExpertDashboardActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.expert.ExpertAnswerActivity"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.activities.expert.ExpertBroadcastActivity"
            android:exported="false" />

        <!-- Utility Activities -->
        <activity
            android:name="com.example.sabzazaar.utils.Permissions"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.utils.LanguagePreference"
            android:exported="false" />
        <activity
            android:name="com.example.sabzazaar.utils.VoicePreference"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.sabzazaar.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>