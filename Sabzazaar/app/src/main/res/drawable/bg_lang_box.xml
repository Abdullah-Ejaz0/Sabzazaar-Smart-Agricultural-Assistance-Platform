<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape>
            <solid android:color="#2e7d32" />
            <stroke android:width="2dp" android:color="#1f5f24" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#d0e8d0" />
            <stroke android:width="2dp" android:color="#2e7d32" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#f5f9f5" />
            <stroke android:width="2dp" android:color="#c8e0c8" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</selector>