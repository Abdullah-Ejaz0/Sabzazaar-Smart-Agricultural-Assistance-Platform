<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/rlHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/btnListen"
            android:layout_toEndOf="@+id/btnBack"
            android:gravity="center"
            android:text="@string/content_desc_camera"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnListen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="@string/content_desc_listen"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/green" />
    </RelativeLayout>

    <!-- Camera View Finder Simulation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llBottomControls"
        android:layout_below="@id/rlHeader"
        android:layout_margin="16dp"
        android:background="@drawable/bg_permission_card"
        android:backgroundTint="@color/green">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="#40000000" />

        <!-- Overlay Box -->
        <View
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_lang_box"
            android:alpha="0.3" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:src="@drawable/bg_demo_note"
            android:alpha="0.1"
            android:background="@drawable/bg_permission_card" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_eye"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/position_leaf_hint"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_camera"
            app:tint="#A5D6A5"
            android:alpha="0.5" />
    </FrameLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/llBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:padding="32dp">

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="@string/scan_crop"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_circle"
            app:tint="@color/green" />
    </LinearLayout>

</RelativeLayout>
