<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e0e3e9"
    tools:context=".activities.auth.OtpPageActivity">

    <ImageButton
        android:id="@+id/backBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        app:tint="#2e7d32" />

    <ImageButton
        android:id="@+id/listenBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_volume_up"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        app:tint="#1f5f24" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verification_code"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1e3a2a"
        app:layout_constraintTop_toBottomOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/code_sent_to_92_300_1234567"
        android:textSize="14sp"
        android:textColor="#3e5e4a"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/otp1"
        android:layout_width="48dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_otp_box"
        android:gravity="center"
        android:textSize="24sp"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/otp2"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="4dp"/>

    <EditText
        android:id="@+id/otp2"
        android:layout_width="48dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_otp_box"
        android:gravity="center"
        android:textSize="24sp"
        android:inputType="number"
        app:layout_constraintTop_toTopOf="@id/otp1"
        app:layout_constraintStart_toEndOf="@id/otp1"
        app:layout_constraintEnd_toStartOf="@id/otp3"
        android:layout_marginEnd="4dp"/>

    <EditText
        android:id="@+id/otp3"
        android:layout_width="48dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_otp_box"
        android:gravity="center"
        android:textSize="24sp"
        android:inputType="number"
        app:layout_constraintTop_toTopOf="@id/otp1"
        app:layout_constraintStart_toEndOf="@id/otp2"
        app:layout_constraintEnd_toStartOf="@id/otp4"
        android:layout_marginEnd="4dp"/>

    <EditText
        android:id="@+id/otp4"
        android:layout_width="48dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_otp_box"
        android:gravity="center"
        android:textSize="24sp"
        android:inputType="number"
        app:layout_constraintTop_toTopOf="@id/otp1"
        app:layout_constraintStart_toEndOf="@id/otp3"
        app:layout_constraintEnd_toStartOf="@id/otp5"
        android:layout_marginEnd="4dp"/>

    <EditText
        android:id="@+id/otp5"
        android:layout_width="48dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_otp_box"
        android:gravity="center"
        android:textSize="24sp"
        android:inputType="number"
        app:layout_constraintTop_toTopOf="@id/otp1"
        app:layout_constraintStart_toEndOf="@id/otp4"
        app:layout_constraintEnd_toStartOf="@id/otp6"
        android:layout_marginEnd="4dp"/>

    <EditText
        android:id="@+id/otp6"
        android:layout_width="48dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_otp_box"
        android:gravity="center"
        android:textSize="24sp"
        android:inputType="number"
        app:layout_constraintTop_toTopOf="@id/otp1"
        app:layout_constraintStart_toEndOf="@id/otp5"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"/>

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/incorrect_otp"
        android:textColor="#D32F2F"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/otp6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/resend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resend_code"
        android:textColor="#2e7d32"
        android:textStyle="bold"
        android:textSize="16sp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/otp1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/verifyBtn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/verify"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#2e7d32"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/resend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>