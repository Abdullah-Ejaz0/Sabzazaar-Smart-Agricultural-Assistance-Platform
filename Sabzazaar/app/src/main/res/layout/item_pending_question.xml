<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerPendingQuestion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_lang_box"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivQuestionType"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_leaf"
        app:tint="@color/green" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvFarmerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ali Raza"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvQuestionSnippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to treat yellow spots on wheat?"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_back"
        android:rotation="180"
        app:tint="@color/green" />
</LinearLayout>
